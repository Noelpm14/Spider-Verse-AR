/*
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://esm.sh https://*.esm.sh https://cdn.jsdelivr.net https://fastly.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com https://storage.googleapis.com blob: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://esm.sh https://*.esm.sh https://cdn.jsdelivr.net https://fastly.jsdelivr.net blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://esm.sh https://*.esm.sh https://cdn.jsdelivr.net https://fastly.jsdelivr.net https://storage.googleapis.com blob: data:; worker-src 'self' blob: data: https://cdn.jsdelivr.net https://fastly.jsdelivr.net https://esm.sh https://*.esm.sh; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:;

/assets/*
  Cache-Control: public, max-age=604800, immutable

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
